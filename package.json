{
  "name": "@freckle/resource-status",
  "version": "1.0.1",
  "description": "ResourceStatusT type and utilities",
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/resource-status-js.git"
  },
  "scripts": {
    "build": "rm -r dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "format-check": "prettier --check 'src/**/*.ts'",
    "lint": "eslint",
    "knip": "knip"
  },
  "dependencies": {
    "@freckle/exhaustive": "^2.0.0",
    "@freckle/maybe": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.5.1"
}
