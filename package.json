{
  "name": "@freckle/resource-status",
  "version": "1.0.1",
  "description": "ResourceStatusT type and utilities",
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/resource-status-js.git"
  },
  "scripts": {
    "build": "rm -r dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "format-check": "prettier --check 'src/**/*.ts'",
    "lint": "eslint",
    "knip": "knip"
  },
  "dependencies": {
    "@freckle/exhaustive": "^2.0.0",
    "@freckle/maybe": "^3.0.0"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.2",
    "@freckle/prettier-config": "^1.3.2",
    "@freckle/tsconfig": "^1.3.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2",
  "prettier": "@freckle/prettier-config"
}
